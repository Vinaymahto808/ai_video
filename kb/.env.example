# Copy to kb/.env. Anything unset falls back to ../voice_clone/.env (gemini_api_key) and the defaults below.

# --- server ---
KB_HOST=127.0.0.1
KB_PORT=4100
# Required in production: management endpoints (/api/crawler/*, /api/knowledge/reindex) need this header.
# Leave empty in local dev to allow loopback callers only.
KB_ADMIN_KEY=

# --- storage ---
KB_DATA_DIR=data
KB_DB_FILE=kb.sqlite

# --- embeddings (Gemini) ---
GEMINI_API_KEY=
KB_EMBED_PROVIDER=gemini
KB_EMBED_MODEL=gemini-embedding-001
KB_EMBED_DIM=768
KB_EMBED_BATCH=32
KB_EMBED_RETRIES=6

# --- chunking ---
KB_CHUNK_SIZE=1200
KB_CHUNK_OVERLAP=200
KB_MIN_PAGE_CHARS=120

# --- search ---
KB_SEARCH_K=5
KB_SEARCH_MIN_SCORE=0.55

# --- crawling ---
KB_MAX_PAGES=1000
KB_MAX_CONCURRENCY=2
KB_NAV_TIMEOUT=45
KB_REQ_TIMEOUT=90
KB_MAX_RETRIES=2
KB_DEACTIVATE_GUARD=0.5
KB_USER_AGENT=Mozilla/5.0 (compatible; TSG-KB-Crawler/0.1; +https://thesachdevgroup.com)
KB_LOG_LEVEL=info
