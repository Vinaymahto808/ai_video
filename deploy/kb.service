[Unit]
Description=Website knowledge base (crawler + search) for human_bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=humanbot
WorkingDirectory=/opt/video/kb
# GEMINI_API_KEY (ideally a query-only paid key), KB_ADMIN_KEY=<long random>, KB_HOST=127.0.0.1,
# KB_TRUST_PROXY=loopback (only if a proxy fronts it), KB_DATA_DIR=/var/lib/kb (backed up)
EnvironmentFile=/etc/kb.env
ExecStart=/usr/bin/node src/server.js
Restart=on-failure
RestartSec=3
KillSignal=SIGTERM
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/kb
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
